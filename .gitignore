# --- Secrets / environment (never commit real values) ---
.env
.env.*
!.env.example

# --- Runtime data (host-side persistent state, see docs/DEPLOYMENT.md) ---
/data/
/backups/

# --- SSH home directory that lives inside this dataset on the NAS ---
# (owned by the CPlanner service account; must never be tracked)
/home/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Node / frontend ---
node_modules/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
.eslintcache

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- Logs / local scratch ---
*.log
