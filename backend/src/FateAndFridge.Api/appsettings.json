{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataDir": "./data",
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "LoginThrottle": {
      "Enabled": true,
      "MaxFailuresPerWindow": 20,
      "WindowSeconds": 600
    }
  }
}
