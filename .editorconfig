# Fate & Fridge — shared editor defaults.
# Applied by VS Code, JetBrains, and most editors on Windows and Linux.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml,json,jsonc,ts,tsx,js,jsx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# EF Core generates migration files with a UTF-8 BOM; leave them untouched
# by formatting/analyzer passes.
[**/Migrations/*.cs]
charset = utf-8-bom
generated_code = true

[*.{bat,cmd,ps1}]
end_of_line = crlf
