# Fate & Fridge — example environment file.
#
# Copy this file to `.env` next to compose.yaml and edit the values:
#   cp .env.example .env
#
# The real `.env` contains secrets and must never be committed.

# --- Household / application ---
# IANA timezone used for household calendar-day semantics.
TZ=UTC
APP_ENV=production
LOG_LEVEL=info

# --- Host port the application is published on ---
HOST_PORT=50080

# --- Host directory for persistent state ---
# Contains postgres/, config/, images/, backups/.
# On TrueNAS use an absolute path on persistent storage, for example:
#   HOST_DATA_DIR=/mnt/Data/calendarplanner/data
HOST_DATA_DIR=./data

# --- PostgreSQL (private to the Docker network; no host port is exposed) ---
POSTGRES_DB=fatefridge
POSTGRES_USER=fatefridge
# Generate a URL-safe password, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-before-first-start
