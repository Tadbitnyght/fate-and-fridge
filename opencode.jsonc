{
  // OpenCode project configuration for Fate & Fridge.
  //
  // Servers marked "disabled": true are stubs — remove the flag and adjust the
  // command once the prerequisite is installed on the workstation, then run
  // /mcps in OpenCode to connect and authenticate.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      // GitHub's official remote MCP server, authenticated with a personal
      // access token. Set GITHUB_MCP_TOKEN in the environment before
      // connecting (classic PAT with repo/workflow scopes or fine-grained
      // equivalent).
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        }
      },
      // Official Playwright MCP server for browser-driven checks against the
      // deployed app. Append "--headless" to the command when no display is
      // available.
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"]
      },
      // Roslyn-powered C# analysis and refactoring, using the locally
      // installed madq-roslynmcp tool (dotnet tool install -g madq-roslynmcp).
      "roslyn": {
        "type": "local",
        "command": ["/home/tadbit/.dotnet/tools/madq-roslynmcp"]
      },
      // Docker MCP Toolkit / Gateway. Stub until the `docker mcp` CLI is
      // available on the workstation (Docker Desktop feature).
      "docker": {
        "type": "local",
        "command": ["docker", "mcp", "gateway", "run"],
        "disabled": true
      }
    }
  }
}
