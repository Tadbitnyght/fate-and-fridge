{
  // OpenCode project configuration for Fate & Fridge.
  //
  // All four servers below are active on this workstation. Add others with
  // `opencode mcp add`, and run /mcps in OpenCode to connect and
  // authenticate servers that need it.
  "$schema": "https://opencode.ai/config.json",
  // Docker infrastructure is owned by the docker-admin subagent. These global
  // rules deny docker/docker compose shell commands and Docker MCP tools for
  // every agent (including lead); docker-admin re-allows them in its agent
  // file. Agent rules are appended after global rules, so its allow wins.
  "permissions": [
    { "action": "docker_*", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "docker *", "effect": "deny" },
    { "action": "shell", "resource": "docker-compose *", "effect": "deny" },
    { "action": "shell", "resource": "sudo docker *", "effect": "deny" },
    { "action": "shell", "resource": "sudo docker-compose *", "effect": "deny" }
  ],
  "mcp": {
    "servers": {
      // GitHub's official remote MCP server, authenticated with a personal
      // access token. Set GITHUB_MCP_TOKEN in the environment before
      // connecting (classic PAT with repo/workflow scopes or fine-grained
      // equivalent).
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
        }
      },
      // Official Playwright MCP server for browser-driven checks against the
      // deployed app. Launched through a wrapper in ~/.local/bin that loads
      // nvm and points Chromium at the private NSS/ALSA libraries, so it
      // works even when the background service was started without nvm's
      // node bin directory on PATH (e.g. from cron). --headless is required
      // because the service may start with no display.
      "playwright": {
        "type": "local",
        "command": ["/home/tadbit/.local/bin/playwright-mcp", "--headless", "--browser", "chromium"]
      },
      // Roslyn-powered C# analysis and refactoring, using the locally
      // installed madq-roslynmcp tool (dotnet tool install -g madq-roslynmcp).
      // The service environment does not have ~/.dotnet on PATH, and the tool's
      // Linux SDK discovery does not probe ~/.dotnet, so pin the workspace to
      // the user SDK (10.0.4xx per backend/global.json) explicitly.
      // FATE_ARTIFACTS_PATH must match the value used by dotnet CLI builds on
      // this workstation (backend/Directory.Build.props redirects obj/bin to it
      // on SMB/9p shares); without it the workspace looks in backend/obj and
      // cannot resolve NuGet references.
      "roslyn": {
        "type": "local",
        "command": ["/home/tadbit/.dotnet/tools/madq-roslynmcp"],
        "environment": {
          "DOTNET_ROOT": "/home/tadbit/.dotnet",
          "ROSLYNMCP_MSBUILD_PATH": "/home/tadbit/.dotnet/sdk/10.0.401",
          "FATE_ARTIFACTS_PATH": "/tmp/fate-and-fridge-artifacts"
        }
      },
      // Docker MCP Toolkit gateway (Docker CLI with the docker-mcp plugin).
      // DOCKER_CONTEXT points it at the TrueNAS daemon over SSH (see
      // docs/DEPLOYMENT.md section 9). Use "default" for the local WSL
      // daemon instead.
      "docker": {
        "type": "local",
        "command": ["docker", "mcp", "gateway", "run"],
        "environment": {
          "DOCKER_CONTEXT": "truenas"
        }
      }
    }
  }
}
